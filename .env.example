# OPENAI_API_KEY: Required for OpenAI Realtime voice session ephemeral token minting.
OPENAI_API_KEY=""

# Realtime Model & Voice configuration
MODEL_ONE="gpt-realtime-2"
MODEL_TWO="gpt-realtime-whisper"
VOICE="shimmer"
REQUIRED_APPROVAL="never"

# MCP Server 1: Shopping / Catalog / Cart / Checkout
MCP_URL_SHOPPING="https://master-group-mcp.anigok.com/mcp"
SERVER_LABEL_SHOP="my_master_server"

# MCP Server 2: Virtual Try-On
MCP_URL_MED="https://virtual-try-on.anigok.com/mcp"
SERVER_LABEL_MED="my_virtual_mcp"

# UCP Agent Profile
PROFILE_URL="https://ucp-agent-profile.facetimefy.com/ucp/agent-profiles/2026-08-25/valid-with-capabilities.json"

# Voice Logger MCP Endpoint & Label
VOICE_URL="https://voicechat.anigok.com/mcp"
VOICE_URL_LABEL="voice_chat_server"


